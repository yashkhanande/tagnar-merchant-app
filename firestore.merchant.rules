rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function phoneSignedIn() {
      return signedIn()
        && request.auth.token.phone_number is string
        && request.auth.token.phone_number.size() > 0;
    }
    function master() {
      return phoneSignedIn()
        && exists(/databases/$(database)/documents/master_access/$(request.auth.uid))
        && get(/databases/$(database)/documents/master_access/$(request.auth.uid)).data.active == true;
    }
    function eligibleMerchant(uid) {
      return exists(/databases/$(database)/documents/merchants_new/$(uid))
        && get(/databases/$(database)/documents/merchants_new/$(uid)).data.phoneNumber is string
        && get(/databases/$(database)/documents/merchants_new/$(uid)).data.phoneNumber.size() > 0
        && get(/databases/$(database)/documents/merchants_new/$(uid)).data.get('suspended', false) == false;
    }
    function ownMerchant(uid) {
      return phoneSignedIn() && request.auth.uid == uid && eligibleMerchant(uid);
    }
    function ownsAnchorData(data) {
      return ownMerchant(data.merchantId)
        && data.anchorId is string
        && data.anchorId.size() > 0;
    }
    function ownsRequestData(data) {
      // Request documents are client-read-only and provisioned by the trusted
      // backend. Merchant ownership is the query-enforceable security boundary;
      // targetScope and anchorDocumentIds are presentation filters.
      return ownMerchant(data.merchantId);
    }
    function validAuthProfile(uid) {
      let d = request.resource.data;
      return d.uid == uid && d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.email == request.auth.token.get('email', '')
        && d.get('phoneNumber', '') == request.auth.token.get('phone_number', '')
        && d.photoUrl is string && d.photoUrl.size() <= 2000
        && d.lastLogin == request.time && d.updatedAt == request.time;
    }
    function validInitialProfile(uid) {
      let d = request.resource.data;
      return d.uid == uid && d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.email == request.auth.token.get('email', '')
        && d.photoUrl is string && d.photoUrl.size() <= 2000
        && d.get('phoneNumber', '') == request.auth.token.get('phone_number', '')
        && d.createdAt == request.time && d.lastLogin == request.time
        && d.updatedAt == request.time;
    }
    function validOnboarding() {
      let d = request.resource.data;
      return d.businessName is string && d.businessName.size() >= 2 && d.businessName.size() <= 200
        && d.businessAddress is string && d.businessAddress.size() >= 5 && d.businessAddress.size() <= 500
        && d.businessType in ['soleProprietorship', 'partnership', 'corporation', 'llc', 'cooperative', 'nonprofit']
        && d.businessPhone is string && d.businessPhone.size() >= 8 && d.businessPhone.size() <= 20
        && d.businessEmail is string && d.businessEmail.size() <= 254
        && d.gstNumber is string && d.gstNumber.size() >= 2 && d.gstNumber.size() <= 30
        && d.city is string && d.city.size() >= 2 && d.city.size() <= 100
        && d.state is string && d.state.size() >= 2 && d.state.size() <= 100
        && d.country is string && d.country.size() >= 2 && d.country.size() <= 100
        && d.postalCode is string && d.postalCode.size() >= 3 && d.postalCode.size() <= 20
        && d.onboardingCompleted == true && d.updatedAt == request.time;
    }
    match /master_access/{uid} {
      allow get: if phoneSignedIn() && request.auth.uid == uid;
      // Only a trusted project administrator/Admin SDK can grant/revoke Masters.
      allow list, create, update, delete: if false;
    }
    match /merchants_new/{uid} {
      allow get: if master() || (phoneSignedIn() && request.auth.uid == uid);
      allow list: if master();
      // Profile writes go through verified callable functions using Admin SDK.
      allow create, update, delete: if false;
    }
    match /anchor/{anchorId} {
      allow read: if ownMerchant(resource.data.merchantId);
      allow write: if false;
    }

    // Operational records are provisioned by trusted backend/Admin SDK jobs.
    // Merchants can only query records carrying their own merchant and anchor IDs.
    match /merchant_requests/{requestId} {
      allow read: if ownsRequestData(resource.data);
      allow write: if false;
    }
    match /merchant_payments/{paymentId} {
      allow read: if ownsAnchorData(resource.data);
      allow write: if false;
    }
    match /merchant_interactions/{interactionId} {
      allow read: if ownsAnchorData(resource.data);
      allow write: if false;
    }
    match /merchant_offers/{offerId} {
      allow read: if ownsAnchorData(resource.data);
      // Offer responses go through respondToOffer.
      allow create, update, delete: if false;
    }
    match /merchant_conversations/{conversationId} {
      allow read: if ownsAnchorData(resource.data);
      // Read receipts go through markConversationRead.
      allow create, update, delete: if false;

      match /messages/{messageId} {
        function conversation() {
          return get(/databases/$(database)/documents/merchant_conversations/$(conversationId));
        }
        allow read: if ownsAnchorData(conversation().data);
        // Merchant messages go through sendMerchantMessage.
        allow create, update, delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
